# Stevi-Konfiguration — kopiere diese Datei nach ".env" und trage deine Werte ein.

# ---------------------------------------------------------------------------
# Welches "Gehirn" Stevi nutzt:
#   ollama  → lokales/selbst-gehostetes Open-Source-Modell. KOSTENLOS, ohne API.
#   claude  → Anthropic-API (stärker, aber kostenpflichtig).
# Ohne Angabe: automatisch (ANTHROPIC_API_KEY vorhanden → claude, sonst → ollama).
# ---------------------------------------------------------------------------
STEVI_BACKEND=ollama

# --- Kostenloser, lokaler Betrieb (Backend = ollama) -----------------------
# Voraussetzung: Ollama installieren (https://ollama.com) und ein Modell ziehen:
#   ollama pull qwen2.5-coder:7b
STEVI_OLLAMA_HOST=http://localhost:11434
STEVI_OLLAMA_MODEL=qwen2.5-coder:7b

# --- Optional: Anthropic-API (Backend = claude) ----------------------------
# Nur nötig, wenn du STEVI_BACKEND=claude verwendest.
# ANTHROPIC_API_KEY=sk-ant-...
# STEVI_MODEL=claude-opus-4-8

# --- Allgemein -------------------------------------------------------------
# Wohin Stevi generierte Mods/Modpacks schreibt (Standard: ./workspace)
STEVI_WORKSPACE=./workspace

# Wohin importiertes Wissen (Mod-Code/Transkripte) gespeichert wird
# (Standard: ./knowledge_data). Wird automatisch mitgeladen.
STEVI_KNOWLEDGE_DIR=./knowledge_data
